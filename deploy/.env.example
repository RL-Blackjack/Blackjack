# deploy/.env.example — deploy/.env 로 복사해 채운다. .env 는 커밋되지 않는다.
PLAY_HOST=play.example.com
RESEARCH_HOST=research.example.com
# 비밀번호는 영문·숫자만(URL 에 그대로 들어가므로 @ / % : # 가 있으면 접속 문자열이 깨진다).
# 만들기: python -c "import secrets; print(secrets.token_hex(24))"
# 관리자 계정(bj) 비밀번호 — 백업·초기화용
POSTGRES_PASSWORD=CHANGE-ME-admin
# 앱 전용 계정(bj_app) 비밀번호 — 서버는 이것으로만 붙는다
APP_DB_PASSWORD=CHANGE-ME-app
# 32자 이상. 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
BJ_JWT_SECRET=CHANGE-ME-jwt
# 구글 클라우드 콘솔 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹). 승인된 자바스크립트 원본에 https://PLAY_HOST 추가. 비우면 버튼이 안 뜬다.
BJ_GOOGLE_CLIENT_ID=
